# ==============================================================================
# UNBIND MACOS DEFAULTS (Prevents dual-triggering)
# ==============================================================================
keybind = cmd+n=unbind
keybind = cmd+t=unbind
keybind = cmd+w=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+f=unbind
keybind = cmd+shift+,=unbind
keybind = cmd+shift+enter=unbind

# ==============================================================================
# LINUX SHORTCUTS FOR MACOS
# ==============================================================================

# Windows and App Management
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+q=quit

# Tab Management
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab

# Go to Specific Tabs (Linux uses Alt + Number)
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab

# Split Management
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
keybind = ctrl+super+shift+up=resize_split:up,10
keybind = ctrl+super+shift+down=resize_split:down,10
keybind = ctrl+super+shift+right=resize_split:right,10
keybind = ctrl+super+shift+left=resize_split:left,10
keybind = ctrl+super+shift+==equalize_splits

# Copy / Paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Configuration Management
keybind = ctrl+shift+,=reload_config

theme = Catppuccin Mocha
